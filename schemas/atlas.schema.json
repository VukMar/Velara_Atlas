{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcr.example.invalid/schemas/atlas.schema.json",
  "title": "Velara Atlas entity contract v1.1",
  "description": "The URL is a schema identifier only; no network access required. Test content is NONCANON.",
  "type": "object",
  "$defs": {
    "xyz": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "x": {
          "const": 0
        },
        "y": {
          "const": 0
        },
        "z": {
          "const": 0
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "unit": {
          "enum": [
            "ly",
            "CNU"
          ]
        },
        "projection": {
          "const": "topdown_xz"
        },
        "planeY": {
          "const": 0
        }
      },
      "required": [
        "origin",
        "size",
        "unit",
        "projection",
        "planeY"
      ],
      "additionalProperties": false
    },
    "datePrecision": {
      "enum": [
        "exact",
        "circa",
        "confirmed_by",
        "within_window",
        "atlas_snapshot",
        "unknown"
      ]
    },
    "namePeriod": {
      "type": "object",
      "properties": {
        "fromAE": {
          "type": "integer",
          "minimum": 0
        },
        "untilAE": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "datePrecision": {
          "$ref": "#/$defs/datePrecision"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "fromAE",
        "untilAE",
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "description": "fromAE inclusive, untilAE exclusive; no overlaps in a single field (cross-item validator)."
    },
    "cantumPeriod": {
      "type": "object",
