          {
            "fromAE": 480,
            "untilAE": 970,
            "text": "Okeanberg is the third established regional government, centred on Rekberg and subordinate to Drevnasel.",
            "datePrecision": "circa"
          },
          {
            "fromAE": 970,
            "untilAE": 1000,
            "text": "Okeanberg has peacefully become sovereign around 970 A.E. The selected visualization anchor is 970; the historical date remains approximate.",
            "datePrecision": "circa"
          },
          {
            "fromAE": 1000,
            "untilAE": 1126,
            "text": "Okeanberg sovereignty is confirmed by 1000 A.E., following its approximate separation around 970. This confirmation is not a new independence event.",
            "datePrecision": "circa"
          },
          {
            "fromAE": 1126,
            "untilAE": 1138,
            "text": "Okeanberg is under invasion. This historical map retains its regional administration and independent governing affiliation until the completed-conquest checkpoint in 1138. Individual capture dates and the precise loss of effective government remain unrecorded.",
            "datePrecision": "within_window"
          },
          {
            "fromAE": 1138,
            "untilAE": 1169,
            "text": "The conquest is confirmed complete by 1138. Okeanberg retains its regional administrative identity under Visshum governing authority; this checkpoint does not date each local capture.",
            "datePrecision": "confirmed_by"
          },
          {
            "fromAE": 1169,
            "untilAE": 1175,
            "text": "Selected systems have been liberated and are unaffiliated from their individual liberation years. The remaining affiliated systems retain Okeanberg regional administration under Visshum governing authority; Okeanberg sovereignty has not yet been restored.",
            "datePrecision": "exact"
          },
          {
            "fromAE": 1175,
            "untilAE": 1201,
            "text": "Okeanberg’s own sovereign government has been restored under Drevnasel influence. Influence does not constitute direct Drevnasel administration.",
            "datePrecision": "exact"
          }
        ]
